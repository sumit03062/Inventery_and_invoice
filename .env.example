# Production backend settings. Local development works without this file.
# Generate a random SECRET_KEY before deployment.
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DATABASE_PATH=/data/shop.sqlite3
# Set COOKIE_SECURE=false only for local HTTP Docker testing.
COOKIE_SECURE=true

# Enable only after configuring provider accounts and webhook endpoints.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
# Choose a supported Graph API version from your Meta app dashboard, e.g. v25.0.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_LANGUAGE=en
REMINDER_INTERVAL_HOURS=72
AUTOMATIC_REMINDERS=false

# Required for the optional encrypted-backup maintenance worker.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=/backups
TRUST_PROXY_HEADERS=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SHOP_DOMAIN=
